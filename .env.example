# ============================================================
# Learner Metrics — Environment Variables
# Copy this file to .env (dev), .env.staging, or .env.prod
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://learner_service:learner_password@localhost:5432/learner_metrics

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=put-your-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Google OAuth ---
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- NCBI / PubMed ---
# Optional — get at: https://www.ncbi.nlm.nih.gov/account/
# Increases rate limit from 3 req/s to 10 req/s
NCBI_API_KEY=

# --- Environment ---
ENVIRONMENT=development   # development | staging | production

# --- Container ports ---
BACKEND_PORT=8201
FRONTEND_PORT=5201

# --- Frontend (Vite build-time) ---
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=